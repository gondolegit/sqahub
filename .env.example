# Salin file ini ke ".env" (JANGAN commit .env yang asli - sudah di-gitignore) lalu isi nilainya
# sebelum menjalankan `docker compose up`.

# WAJIB: JWT harus pakai secret sendiri, jangan pakai nilai default di repo (itu contoh dev lokal,
# sudah pernah tercatat di git history jadi tidak aman dipakai produksi). Generate string acak panjang, mis.:
#   openssl rand -hex 64
JWT_SECRET=

# Password root MySQL untuk container mysql (docker-compose.yml)
MYSQL_ROOT_PASSWORD=changeme

# Domain frontend yang diizinkan CORS, pisahkan koma
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Opsional: forgot-password (Gmail SMTP). Kosongkan kalau fitur ini belum dipakai.
MAIL_USERNAME=
MAIL_APP_PASSWORD=

# Opsional: login Google. Kosongkan kalau fitur ini belum dipakai (aplikasi tetap jalan normal).
APP_OAUTH2_GOOGLE_CLIENT_ID=
APP_OAUTH2_GOOGLE_CLIENT_SECRET=
